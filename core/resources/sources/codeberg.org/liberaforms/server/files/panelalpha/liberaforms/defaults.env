# Settings LiberaForms reads with os.environ[...] and so needs to boot, from the
# repo's dotenv.example. Any of them can be overridden in the project's
# environment variables (.env is read after this file).
FLASK_CONFIG=production
FLASK_DEBUG=False
DB_HOST=db
DB_NAME=liberaforms
DB_USER=liberaforms
DEFAULT_LANGUAGE=en-US
DEFAULT_TIMEZONE=UTC
TMP_DIR=/tmp
LOG_DIR=logs
SESSION_TYPE=filesystem
TOKEN_EXPIRATION=604800
ENABLE_UPLOADS=True
ENABLE_REMOTE_STORAGE=False
TOTAL_UPLOADS_LIMIT=1 GB
DEFAULT_USER_UPLOADS_LIMIT=50 MB
MAX_MEDIA_SIZE=512000
MAX_ATTACHMENT_SIZE=1572864
ENABLE_LDAP=False
GUNICORN_WORKERS=2
