# Upstream's self-hosting Caddyfile without TLS (the engine terminates it):
# /api goes to the API, everything else to the dashboard.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode gzip

	handle_path /api* {
		reverse_proxy op-api:3000
	}

	reverse_proxy op-dashboard:3000
}
