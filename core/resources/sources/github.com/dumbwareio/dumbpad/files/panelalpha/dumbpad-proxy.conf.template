# The only thing on the account's port. The image's entrypoint renders this
# with ${DUMBPAD_PIN}; the rendered file stays inside the container.
#   - a websocket upgrade needs the PIN cookie (upstream checks none)
#   - a wrong PIN cookie is throttled: upstream compares it on every /api call
#     with no lockout, so it would otherwise be an unlimited PIN oracle

map $cookie_dumbpad_auth $dumbpad_bad_cookie {
    default          "bad";
    ""               "";
    "${DUMBPAD_PIN}" "";
}

map $http_upgrade $dumbpad_connection {
    default upgrade;
    ''      close;
}

# One shared bucket: every client arrives from the engine's proxy anyway.
limit_req_zone $dumbpad_bad_cookie zone=dumbpad_bad:1m rate=10r/m;

server {
    listen 8080 default_server;
    server_name _;
    client_max_body_size 10m;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $dumbpad app:3000;

    location = /_dumbpad_gate {
        internal;
        if ($http_upgrade = "") {
            return 204;
        }
        if ($cookie_dumbpad_auth = "${DUMBPAD_PIN}") {
            return 204;
        }
        return 403;
    }

    location / {
        # preaccess (throttle) runs before access (gate), so a guessed cookie
        # is counted even when the gate refuses it.
        limit_req zone=dumbpad_bad burst=10 nodelay;
        limit_req_status 429;
        auth_request /_dumbpad_gate;

        proxy_pass http://$dumbpad$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $dumbpad_connection;
        proxy_read_timeout 3600s;
    }
}
