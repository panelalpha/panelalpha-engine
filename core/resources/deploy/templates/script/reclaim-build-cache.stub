set -e
ROOT="/home/$(hostname)/docker"
supervisorctl -c /etc/supervisor/supervisord.conf stop docker >/dev/null 2>&1 || true
rm -rf "$ROOT/buildkit"
rm -rf "$ROOT/containerd/daemon/io.containerd.snapshotter.v1.overlayfs"
rm -rf "$ROOT/containerd/daemon/io.containerd.metadata.v1.bolt"
rm -rf "$ROOT/containerd/daemon/tmpmounts"
mkdir -p "$ROOT"
supervisorctl -c /etc/supervisor/supervisord.conf start docker >/dev/null 2>&1 || true
for i in $(seq 1 60); do
  docker info >/dev/null 2>&1 && exit 0
  sleep 1
done
echo "docker did not become ready after cache cleanup" >&2
exit 1
