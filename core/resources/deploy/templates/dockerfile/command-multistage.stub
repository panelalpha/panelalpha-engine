FROM {{ image }} AS build
WORKDIR /app
{{# build_node_image }}
COPY --from={{ build_node_image }} /usr/local/bin/ /usr/local/bin/
COPY --from={{ build_node_image }} /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
COPY --from={{ build_node_image }} /opt/ /opt/
{{/ build_node_image }}
COPY . .
{{ env }}
{{# install_command }}
RUN {{ install_command }}
{{/ install_command }}
{{# build_command }}
RUN {{ build_command }}
{{/ build_command }}

FROM {{ runtime_image }}
WORKDIR /app
{{ env }}
COPY --from=build /app/{{ output_directory }} ./{{ output_directory }}
EXPOSE {{ port }}
{{ entrypoint }}
