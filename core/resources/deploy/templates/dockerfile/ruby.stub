FROM {{ ruby_image }} AS base
{{^ prebuilt }}
RUN apt-get update \
 && apt-get install -y --no-install-recommends {{ system_packages }} \
 && rm -rf /var/lib/apt/lists/*
{{/ prebuilt }}
{{# bundle_deployment }}
ENV BUNDLE_DEPLOYMENT=1
{{/ bundle_deployment }}
ENV BUNDLE_PATH=/usr/local/bundle
ENV BUNDLE_WITHOUT="development:test"
{{ environment }}
WORKDIR /app
COPY Gemfile ./
COPY Gemfile.lock* ./
COPY .ruby-version* .tool-versions* ./
RUN bundle install --jobs 4 --retry 3 \
 && rm -rf ~/.bundle /usr/local/bundle/ruby/*/cache

{{ frontend_stage }}
FROM base AS app
COPY . .
{{# frontend_stage }}
COPY --from=assets /app/public ./public
{{/ frontend_stage }}
{{# js_bundling }}
COPY --from=assets /app/app/assets/builds ./app/assets/builds
{{/ js_bundling }}
{{# assets_precompile }}
{{# js_bundling }}
RUN mkdir -p /tmp/pa-js-built \
 && for tool in yarn npm pnpm bun; do printf '#!/bin/sh\nexit 0\n' > /tmp/pa-js-built/$tool && chmod +x /tmp/pa-js-built/$tool; done \
 && PATH=/tmp/pa-js-built:$PATH SKIP_JS_BUILD=1 SKIP_CSS_BUILD=1 SECRET_KEY_BASE_DUMMY=1 SECRET_KEY_BASE=panelalpha-assets-precompile bundle exec rails assets:precompile \
 || echo "PANELALPHA: rails assets:precompile failed; the app starts without precompiled assets"; rm -rf /tmp/pa-js-built
{{/ js_bundling }}
{{^ js_bundling }}
RUN SECRET_KEY_BASE_DUMMY=1 SECRET_KEY_BASE=panelalpha-assets-precompile bundle exec rails assets:precompile \
 || echo "PANELALPHA: rails assets:precompile failed; the app starts without precompiled assets"
{{/ js_bundling }}
{{/ assets_precompile }}
EXPOSE {{ port }}
CMD {{ start_command }}
