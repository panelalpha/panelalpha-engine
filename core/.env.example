APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1


MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# PanelAlpha Hub — licensing, *.panelalpha.online (WithoutDNS) and telemetry
PANELALPHA_HUB=https://hub.panelalpha.com
PANELALPHA_MONITORING=https://monitoring.panelalpha.com

SWAGGER_ENABLED=false
SWAGGER_GENERATE_ALWAYS=false

# MCP tool exposure. The engine exposes one MCP tool per documented API
# operation, and that API is root-equivalent, so these decide how much of the
# server an MCP client can reach. Filters only ever remove; a tool must survive
# all of them. See config/mcp-tools.php, and `php artisan mcp:tool:list` to print
# what the current settings actually expose.
#
# Groups to enable (OpenAPI tag, or "engine" for the built-in summaries).
# Every group is on, so this line is how an install narrows it -- take the
# server-level groups (csf, modsecurity, ipmanagement, tunnels, proxyrules,
# system) out by naming only the ones to keep.
MCP_TOOLSETS=all
# Individual tools enabled on top of those groups.
MCP_TOOLS=
# Ceiling on what any tool may do: readonly | modify | full.
MCP_PERMISSION_MODE=full
# Tools to remove. Comma-separated, "*" wildcard allowed.
MCP_DENIED_TOOLS=
# Same, as a regular expression, without delimiters.
MCP_DENIED_TOOLS_REGEX=
