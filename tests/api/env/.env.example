# PanelAlpha Engine — API test suite
#
# You normally do not write this file by hand. `npm test` creates it the first
# time it runs: on the engine host it invents the hostname and mints a token
# with pae-artisan; from a laptop, `npm run env:setup` asks or takes --host:
#
#   npm run env:setup -- --host 203.0.113.10
#
# That mints an API token on the engine over SSH, checks it against the live
# API, and writes env/.env.

# ============================================================================
# Required
# ============================================================================

# Engine API root. A trailing slash is added automatically if missing.
API_BASE_URL=https://engine.example.com:2011/api/

# Bearer token for the Engine API. Mint one on the engine host with:
#   pae-artisan api:token:create api-tests --short
# or, if the wrapper is not installed:
#   docker compose -f /opt/panelalpha/shared-hosting/docker-compose.yml exec -T core \
#     php artisan api:token:create api-tests --short
API_TOKEN=

# ============================================================================
# Base domain — derived automatically, override only if you must
# ============================================================================

# Generated extra domains (addons, explicit create payloads) are subdomains of
# this. Default project creates omit `domain` and `tunnel`, so the engine names
# them: panelalpha.online first, then panelalpha.direct. Extra names hang off
# the zone npm test reads from GET /system/info.
#
#   API_BASE_URL host 203.0.113.10        ->  addons under 203-0-113-10.panelalpha.direct
#   API_BASE_URL host engine.example.com  ->  engine default_ipv4 / cert_domain
#
# Set this only to point extra names at a domain whose DNS you manage yourself.
# A leftover *.sslip.io value is ignored.
# DOMAIN=

# ============================================================================
# Webserver profile
# ============================================================================

# Loads env/.env.<TEST_ENV> on top of this file, and keeps report, results and
# setup state separate per profile. E.g. nginx, apache, litespeed, openlitespeed.
# TEST_ENV=nginx

# LiteSpeed Enterprise serial — required only when switching to litespeed.
# Keep the real value in CI as a masked variable, never in this file.
# LITESPEED_SERIAL_NUMBER=

# ============================================================================
# Timing overrides (milliseconds)
# ============================================================================

# PROPAGATION_DELAY=5000
# PHP_EXECUTION_DELAY=3000
# CRON_CHECK_INTERVAL=5000
# CRON_MAX_WAIT_TIME=120000
# API_CALL_TIMEOUT=60000
# WEBSERVER_CHANGE_TIMEOUT=1800000
# DEPLOY_TIMEOUT=600000

# ============================================================================
# Network
# ============================================================================

# SFTP_PORT=2222
# MYSQL_HOST=database-users.shared-hosting.palocal

# ============================================================================
# Reporting
# ============================================================================

# Set to a path to additionally emit a JUnit XML report (used by CI).
# JUNIT_REPORT_FILE=.playwright/junit/results.xml

# Host printed by `npm run report` / the post-run hint. Default is the
# API_BASE_URL hostname, then `hostname -f`, then the first public IPv4.
# Set this when those resolve to loopback (typical on the engine box).
# REPORT_HOST=engine.example.com
# REPORT_PORT=9323

# ============================================================================
# Host CLI (`pae-artisan`) and optional git deploy
# ============================================================================

# Wrapper binary, when it is not on PATH as pae-artisan / pae.
# PAE_BIN=/usr/local/bin/pae-artisan

# SSH into the engine to run pae-artisan when the suite is not on that host.
# ENGINE_SSH_HOST is derived from API_BASE_URL when unset.
# ENGINE_SSH_HOST=
# ENGINE_SSH_USER=root
# ENGINE_SSH_KEY=

# Optional private-repo inspect / deploy.
# GIT_REPO=https://github.com/octocat/Spoon-Knife.git
# GIT_TOKEN=

# Isolated specs that mutate host networking (network-config, NAT provisioning).
# Leave unset. The main api project skips those describes without it.
# ALLOW_NETWORK_MUTATION=1
# ALLOW_PAE_REGISTER=1

# Files a real bug report, which the engine ships to production monitoring.
# Leave unset outside a deliberate end-to-end check of the report channel.
# ALLOW_BUG_REPORT_SHIP=1
