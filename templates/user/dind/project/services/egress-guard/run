#!/bin/sh
# engine#217: keeps /entrypoint.d/egress-guard.sh applied -- it has to hook the
# inner daemon's DOCKER-USER (every second until it does, then every 15s) and
# follow the MySQL and registry addresses. The engine writes `down` while
# DIND_EGRESS_GUARD is off.
while :; do [ -f /entrypoint.d/egress-guard.sh ] && sh /entrypoint.d/egress-guard.sh; if iptables -C DOCKER-USER -j PA-TENANT-EGRESS 2>/dev/null; then sleep 15; else sleep 1; fi; done
