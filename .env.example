# Which optional service groups start. The control plane -- core (its data is
# core.sqlite, on core-storage; it also serves the :2011 API) -- always
# starts and is not a profile.
#
#   hosting     sites-http, sites-dns, sites-db  (serving tenant sites)
#   mail        mail
#   ftp         ftp, sftp
#   metrics     metrics
#   phpmyadmin  sites-phpmyadmin (pulls in sites-db)
#   lighthouse  lighthouse
#   legacy-mysql-core  core-db (MariaDB) for core's own data instead of
#               core.sqlite -- not part of `full`; set this yourself before
#               the stack first starts to choose MySQL on a fresh install,
#               or the updater adds it for you on a host that already had
#               core-db before this setting existed. See docs/internal/core-db.md.
#   registry-proxy  a credentials-only pass-through to docker.io, so every
#               dind account's pulls count against your Docker Hub account's
#               rate limit instead of the host IP's anonymous one. It keeps
#               nothing: its storage is a tmpfs, swept every few minutes.
#   full        every one of the above except legacy-mysql-core -- the
#               default, and the only value that gives the same stack as
#               before profiles existed
#
# Leave it empty for a control-plane-only engine. Comma-separated, no spaces.
COMPOSE_PROFILES=full

# Only used when legacy-mysql-core is in COMPOSE_PROFILES above -- core-db's
# own password, not core.sqlite's. The installer fills this in for you.
CORE_MYSQL_PASSWORD=
USERS_MYSQL_ROOT_PASSWORD=

# The Docker Hub account registry-proxy logs in as, and the whole point of
# that profile: pulls it makes count as authenticated (200 per 6h) rather
# than anonymous (100 per 6h, shared by every account on this host's IP).
# Empty means the proxy runs but authenticates as nobody, which buys nothing.
#
# Use a dedicated Hub account that owns nothing, and an access token with
# public read-only scope rather than the password -- every account daemon on
# this host can pull through the proxy, so whatever this login can read, a
# tenant can pull. The names match the registry's own REGISTRY_PROXY_* config
# variables on purpose; compose passes them straight through.
REGISTRY_PROXY_USERNAME=
REGISTRY_PROXY_PASSWORD=

# How long the proxy keeps what it fetched, before its own scheduler
# expires it (default 30m). Shorter holds less and also gives away more of
# the rate-limit protection this profile exists for, since anything expired
# is fetched from Docker Hub again on the next pull.
#
# The compose file also sets delete.enabled, without which expiry runs but
# frees nothing. Expiry leaves a few KB of manifest links behind; those are
# left alone, and `system:registry-proxy:trim` clears the store by hand if a
# host ever needs it.
#REGISTRY_PROXY_TTL=30m

MEM_LIMIT_CORE=6G
MEMSWAP_LIMIT_CORE=0
MEM_LIMIT_CORE_DB=3G
MEMSWAP_LIMIT_CORE_DB=0
MEM_LIMIT_SITES_HTTP_NGINX=3G
MEMSWAP_LIMIT_SITES_HTTP_NGINX=0
MEM_LIMIT_SITES_HTTP_NGINX_PROXY=3G
MEMSWAP_LIMIT_SITES_HTTP_NGINX_PROXY=0
MEM_LIMIT_SITES_HTTP_APACHE=3G
MEMSWAP_LIMIT_SITES_HTTP_APACHE=0
MEM_LIMIT_SITES_HTTP_LITESPEED=3G
MEMSWAP_LIMIT_SITES_HTTP_LITESPEED=0
MEM_LIMIT_SITES_HTTP_OPENLITESPEED=3G
MEMSWAP_LIMIT_SITES_HTTP_OPENLITESPEED=0
MEM_LIMIT_FTP=3G
MEMSWAP_LIMIT_FTP=0
MEM_LIMIT_SITES_DB=3G
MEMSWAP_LIMIT_SITES_DB=0
MEM_LIMIT_SITES_PHPMYADMIN=3G
MEMSWAP_LIMIT_SITES_PHPMYADMIN=0

PHPMYADMIN_UPLOAD_LIMIT=2048M
