# Which optional service groups start. The control plane -- core (its data is
# core.sqlite, on core-storage) and core-http (the :2011 API) -- always
# starts and is not a profile.
#
#   hosting     sites-http, sites-dns, sites-db  (serving tenant sites)
#   mail        mail
#   ftp         ftp, sftp
#   metrics     metrics
#   phpmyadmin  sites-phpmyadmin (pulls in sites-db)
#   lighthouse  lighthouse
#   legacy-mysql-core  core-db (MariaDB) for core's own data instead of
#               core.sqlite -- not part of `full`; set this yourself before
#               the stack first starts to choose MySQL on a fresh install,
#               or the updater adds it for you on a host that already had
#               core-db before this setting existed. See docs/internal/core-db.md.
#   full        every one of the above except legacy-mysql-core -- the
#               default, and the only value that gives the same stack as
#               before profiles existed
#
# Leave it empty for a control-plane-only engine. Comma-separated, no spaces.
COMPOSE_PROFILES=full

# Only used when legacy-mysql-core is in COMPOSE_PROFILES above -- core-db's
# own password, not core.sqlite's. The installer fills this in for you.
CORE_MYSQL_PASSWORD=
USERS_MYSQL_ROOT_PASSWORD=

MEM_LIMIT_CORE=6G
MEMSWAP_LIMIT_CORE=0
MEM_LIMIT_CORE_DB=3G
MEMSWAP_LIMIT_CORE_DB=0
MEM_LIMIT_CORE_HTTP=3G
MEMSWAP_LIMIT_CORE_HTTP=0
MEM_LIMIT_SITES_HTTP_NGINX=3G
MEMSWAP_LIMIT_SITES_HTTP_NGINX=0
MEM_LIMIT_SITES_HTTP_NGINX_PROXY=3G
MEMSWAP_LIMIT_SITES_HTTP_NGINX_PROXY=0
MEM_LIMIT_SITES_HTTP_APACHE=3G
MEMSWAP_LIMIT_SITES_HTTP_APACHE=0
MEM_LIMIT_SITES_HTTP_LITESPEED=3G
MEMSWAP_LIMIT_SITES_HTTP_LITESPEED=0
MEM_LIMIT_SITES_HTTP_OPENLITESPEED=3G
MEMSWAP_LIMIT_SITES_HTTP_OPENLITESPEED=0
MEM_LIMIT_FTP=3G
MEMSWAP_LIMIT_FTP=0
MEM_LIMIT_SITES_DB=3G
MEMSWAP_LIMIT_SITES_DB=0
MEM_LIMIT_SITES_PHPMYADMIN=3G
MEMSWAP_LIMIT_SITES_PHPMYADMIN=0
# queue:work processes in core; deploys running at once, at most.
QUEUE_WORKERS=8

PHPMYADMIN_UPLOAD_LIMIT=2048M
