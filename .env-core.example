APP_NAME=PanelAlphaEngineCore
APP_ENV=production
APP_KEY=
APP_DEBUG=
APP_URL=
# Identifies this install to Connect and monitoring (X-Engine-App-UID header).
# The installer generates it once and never replaces a value already here, so a
# provisioning script may set it before installing.
APP_UID=

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

KEEP_WEBSERVER_LOGS_FOR_DELETED_DOMAINS=

# Deploy telemetry — anonymous reports about failed/degraded app deploys, used
# to improve detection rules, framework recipes and source app configs.
# Reports carry no username, no repository token, no host address and no
# absolute path; installs are identified by a hash of machine facts and by
# APP_UID above.
# TELEMETRY_ENABLED=false stops reports being *sent*. It does not stop them
# being written: every deploy is recorded to storage/logs/telemetry.log
# whatever this is set to, so an install with reporting switched off still
# accumulates a file the operator can hand over later.
# TELEMETRY_TIER: 0 metadata, 1 + repo identity, 2 + redacted log tail.
TELEMETRY_ENABLED=true
TELEMETRY_TIER=2

# Where reports are sent: PanelAlpha Monitoring, plus the route on it. NOT the
# Connect — that is an integration the engine calls (WithoutDNS names,
# licensing), monitoring is where it reports what it did. Two services,
# deployed apart. Empty means nowhere: reports stay in the spool, and a host
# that is unreachable or not serving yet holds them rather than dropping them.
#
# https since the host started serving 443. Port 80 now answers with a 301 to
# it, and a redirected POST arrives as a GET, so an install still pinned to
# http:// gets a 405 from the ingest and ships nothing. Reports are redacted,
# but redacted is not encrypted.
# PANELALPHA_MONITORING=https://monitoring.panelalpha.com
# TELEMETRY_REPORTS_PATH=/api/v1/events   # the shared event route the ingest serves
# TELEMETRY_TOKEN=          # optional, sent as Authorization when set
# TELEMETRY_LOG_DAYS=30     # retention of the local telemetry log

# PanelAlpha Connect, for the WithoutDNS integration and licensing. Nothing to do with
# telemetry; see PANELALPHA_MONITORING above.
# PANELALPHA_CONNECT=https://connect.panelalpha.com

# Bug reports — `pae-artisan telemetry:bug-report <project>`,
# `POST /api/bug-reports` and the bug_report_create MCP tool, all queued on the
# spool above and shipped in the same batch as the install events, as
# `support.bug_report`.
# A report is always about one deployed app, and the engine attaches the
# evidence itself: what it detects the application to be (the same inspection
# the panel shows), a live probe of every port it publishes, its last deploy
# and the tail of that deploy's log.
# The body is free text somebody typed. It and everything gathered around it are
# redacted like build output, and a report may carry a `contact` address the
# reporter supplied so support can answer them — the only field in this
# subsystem that identifies a person, and never filled in automatically.
# Filing a report is refused outright when this or TELEMETRY_ENABLED is off:
# nothing would ever ship it, and saying "filed" would be a promise the engine
# cannot keep.
TELEMETRY_BUG_REPORTS=true

# Source bundles — zip and upload the customer's application source with a
# failure report. Separate from TELEMETRY_TIER on purpose: a repository is the
# customer's intellectual property, not diagnostic data.
#
#   off          the default. Leave it here.
#   unexplained  the supported opt-in — switch on for one install and one
#                investigation, then switch back to off.
#   failed       discouraged; a standing export of customer code.
#
# Excludes .git, dependencies, build output, every .env but the examples,
# private keys, certificates and database dumps. See docs/08-telemetry/what-is-collected.md.
TELEMETRY_SOURCE_BUNDLE=off

# Memory a host build container may use, or empty to size it from the host.
# A build runs on the engine, not in the account, so this is the operator's
# ceiling rather than a hosting plan's. Left empty -- the default -- it is a
# third of this machine's RAM, floored at 2g and capped at 8g: Chamilo 2.x's
# Encore build OOMs inside a flat 2g on a 15 GB host and needs ~4300 MB of
# heap. Set a Docker size string (512m, 2g, 4096m) to override that for every
# build; an unparseable value falls back to the host-derived default rather
# than failing every deploy.
DEPLOY_BUILD_MEMORY=

# How many queue:work processes core runs -- every deploy, backup and staging
# job shares this one queue, so it is the only knob for how much of it runs at
# once. Change it with `pae configure queue`, which applies live, no restart;
# editing this line by hand needs one (`supervisorctl update` inside core, or
# `docker compose restart core`) to take effect. See App\Support\QueueWorkers.
QUEUE_WORKERS=2

# Which of the engine's MCP tools a client may see and call. The API behind them
# is root-equivalent by design, so this is the difference between handing an
# assistant a read-only view of the server and handing it the ability to delete a
# hosting account. Documented in full in docs/internal/mcp.md.
#
# `pae configure mcp` asks these four as questions and writes the answers here,
# printing how many tools each choice leaves before anything is written. Editing
# them by hand works just as well; core has to restart either way for a change
# made in an editor to reach the running engine.
#
#   MCP_TOOLSETS=                     unset gives every group -- csf, modsecurity,
#                                     ipmanagement, tunnels, proxyrules, system,
#                                     backupcontainers and the rest
#   MCP_TOOLSETS=...                  a comma list of groups to keep, e.g.
#                                     projects,deploy,domains,files,git,containers
#   MCP_TOOLS=project_list,project_get   single tools on top of those groups
#   MCP_PERMISSION_MODE=readonly      ceiling: readonly | modify | full
#   MCP_DENIED_TOOLS=*_delete         removed by name or wildcard
#
# Everything is exposed, so the ceiling is what limits the damage: an install
# whose agent only deploys can leave MCP_PERMISSION_MODE=full and take the
# server-level groups away with a narrower MCP_TOOLSETS, or keep the whole
# surface and cut the destructive operations with MCP_DENIED_TOOLS.
#
# A client fetches tools/list when it connects, so a change here needs the client
# to reconnect as well as core to restart. `Mcp\ToolPolicyTest` asserts the
# shipped default is every group and that naming groups narrows it.
#
# MCP_TOOLSETS=
# MCP_TOOLS=
# MCP_PERMISSION_MODE=full
# MCP_DENIED_TOOLS=
# MCP_DENIED_TOOLS_REGEX=

# City MMDB used for visitor country / continent / region breakdowns.
# Geo lists stay empty until an operator runs `pae geolocation:database update`
# (DB-IP IP to City Lite, CC BY 4.0). That command is not scheduled and is not
# part of install. Visitor IPs are looked up on this host only.
# See docs/05-capabilities/visitor-statistics.md
# GEOLOCATION_DRIVER=dbip
